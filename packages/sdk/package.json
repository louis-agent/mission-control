{
  "name": "@mission-control/sdk",
  "version": "0.1.0",
  "description": "Type-safe SDK client for the Mission Control API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
