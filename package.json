{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered mission control system for coordinating autonomous agent workflows",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mission-control/core build && pnpm --filter @mission-control/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @mission-control/core build && packages/core/node_modules/.bin/tsx scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
